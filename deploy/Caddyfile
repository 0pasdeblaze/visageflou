# Static-only server for the face blurring site. No backend, no uploads, no access logs.
# SITE_ADDRESS: ":8080" behind another proxy, or a domain name for Caddy-managed HTTPS.
{
	admin off
}

{$SITE_ADDRESS::8080} {
	root * /srv
	file_server
	encode zstd gzip

	# Only GET/HEAD make sense for a static site; refuse anything that could carry a body.
	@writes {
		not method GET HEAD OPTIONS
	}
	respond @writes 405

	header {
		# Same policy as the <meta> tag baked into index.html, plus what only a header can express.
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' blob: data:; connect-src 'self'; worker-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		# Cross-origin isolation enables multi-threaded WASM.
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		Cross-Origin-Resource-Policy same-origin
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# The page and the service worker must always be revalidated so updates reach visitors.
	@fresh path / /index.html /sw.js
	header @fresh Cache-Control "no-cache"

	# Hashed build output never changes; everything else revalidates.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@static path /ort/* /models/*
	header @static Cache-Control "public, max-age=86400"
}

# www redirige vers le domaine principal (supprimer ce bloc derrière un reverse proxy).
www.visageflou.fr {
	redir https://visageflou.fr{uri} permanent
}
